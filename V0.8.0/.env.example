# CAD Inspector V0.4.3 - exemplo de configuração
# Copie este arquivo para .env e ajuste os valores.
# OBS.: a V0.4.3 não carrega .env automaticamente; defina essas variáveis no Windows
# ou adapte o run.bat conforme sua infraestrutura.

APP_BASE_URL=http://10.101.0.204:8010

SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_USER=cadinspector@seudominio.com
SMTP_PASSWORD=troque_esta_senha
SMTP_FROM=cadinspector@seudominio.com
SMTP_TLS=true

# Somente para teste local, sem SMTP:
# EMAIL_DEV_MODE=true
